menu = {"1": ("Soto", 15000), "2": ("Rawon", 20000)}
total = 0

print("=== MINI KASIR ===")
print("1. Soto  - 15000")
print("2. Rawon - 20000")

while True:
    pilih = input("Pilih menu (1/2, 0 untuk selesai): ")
    if pilih == "0":
        break
    if pilih in menu:
        jumlah = int(input("Jumlah: "))
        nama, harga = menu[pilih]
        total += harga * jumlah
        print(nama, "x", jumlah, "=", harga * jumlah)
    else:
        print("Menu tidak ada")

print("Total bayar:", total)
bayar = int(input("Uang bayar: "))
print("Kembalian:", bayar - total)
